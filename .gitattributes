# Normalize line endings on checkout, commit with LF in the repo.
* text=auto eol=lf

# Windows / Linux scripts keep their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pt binary
*.onnx binary
*.db binary

# Lockfiles must stay exact.
requirements.txt text eol=lf
